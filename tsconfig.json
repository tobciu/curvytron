{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    "allowJs": true,
    "checkJs": false,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/shared/**/*",
    "src/server/**/*",
    "src/client/core/**/*",
    "src/client/model/**/*",
    "src/client/animation/**/*",
    "scripts/**/*"
  ],
  "exclude": ["node_modules", "dist", "dist-server", "doc/reference-build"]
}
