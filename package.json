{
  "name": "curvytron",
  "version": "2.0.0-dev.0",
  "description": "A web multiplayer Tron game like... with curves!",
  "keywords": [
    "tron",
    "game",
    "indie",
    "html5",
    "multiplayer"
  ],
  "homepage": "https://github.com/Elao/curvytron",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elao/curvytron"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "contributors": [
    {
      "name": "Johan Dufour",
      "email": "johan.dufour@gmail.com",
      "homepage": "https://github.com/lutangar"
    },
    {
      "name": "Thomas JARRAND",
      "email": "thomas.jarrand@gmail.com",
      "homepage": "http://thomas-jarrand.com"
    }
  ],
  "scripts": {
    "build": "node scripts/prepare-reference-web.mjs && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist-server/main.js",
    "dev": "node scripts/build-server.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.0",
    "eslint": "^9.13.0",
    "globals": "^15.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^3.2.4"
  }
}
