{
    "name": "curvytron",
    "version": "3.1.1",
    "description": "A web multiplayer Tron game like... with curves!",
    "keywords": [
        "tron",
        "game",
        "indie",
        "html5",
        "devops"
    ],
    "homepage": "https://github.com/Elao/curvytron",
    "repository": {
        "type": "git",
        "url": "https://github.com/Elao/curvytron"
    },
    "license": "MIT",
    "contributors": [
        {
            "name": "Johan Dufour",
            "email": "johan.dufour@gmail.com",
            "homepage": "https://github.com/lutangar"
        },
        {
            "name": "Thomas JARRAND",
            "email": "thomas.jarrand@gmail.com",
            "homepage": "http://thomas-jarrand.com"
        }
    ],
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "imports": {
        "#event-emitter": {
            "node": "./src/server/EventEmitter.ts",
            "default": "./src/client/EventEmitter.ts"
        }
    },
    "scripts": {
        "dev": "node --disable-warning=ExperimentalWarning src/server/launcher.ts --dev",
        "build": "vite build",
        "start": "node --disable-warning=ExperimentalWarning src/server/launcher.ts",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "npm run build && playwright test",
        "typecheck": "vue-tsc --noEmit",
        "load-test": "node tools/load-test.ts",
        "sprite": "node tools/build-sprite.ts",
        "storage:rebuild": "node --disable-warning=ExperimentalWarning tools/storage-rebuild.ts",
        "test:visual": "npm run build && playwright test --project=visual",
        "test:visual:update": "npm run build && playwright test --project=visual --update-snapshots"
    },
    "dependencies": {
        "express": "^5.1.0",
        "ws": "^8.18.0"
    },
    "optionalDependencies": {
        "influx": "^5.9.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@playwright/test": "^1.56.1",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.5",
        "@types/pngjs": "^6.0.5",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^9.0.0",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^16.0.0",
        "html-minifier-terser": "^7.2.0",
        "jsdom": "^29.1.1",
        "pngjs": "^7.0.0",
        "prettier": "^3.3.0",
        "sass": "^1.80.0",
        "@vitest/coverage-v8": "^3.0.0",
        "typescript": "~5.9",
        "typescript-eslint": "^8.72.0",
        "vite": "^7.0.0",
        "vitest": "^3.0.0",
        "vue": "^3.5.44",
        "vue-router": "^4.6.4",
        "vue-tsc": "^3.3.13"
    }
}
